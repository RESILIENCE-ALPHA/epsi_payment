# EPSI Pay — front (SPA) + relais /api vers la passerelle
# Variables substituées au démarrage (envsubst de l'image nginx) : API_UPSTREAM, NGINX_RESOLVER

# Résolution DNS dynamique : si la passerelle redémarre (nouvelle IP), nginx la retrouve sans redémarrer
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

# Politique de cache par chemin. Les add_header sont tous posés au niveau server : un add_header
# dans une location annulerait les en-têtes de sécurité hérités.
map $uri $cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";
    ~^/api/     "";
    default     "no-cache";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # En-têtes de sécurité (tout est servi depuis la même origine)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Vide pour /api : la passerelle garde la maîtrise du cache de ses réponses
    add_header Cache-Control $cache_control always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Sonde liveness/readiness (Compose, Kubernetes)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Passerelle API : /api/auth/login -> ${API_UPSTREAM}/auth/login
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # La passerelle (TRUST_PROXY=1) retient l'adresse ajoutée ici : l'IP réelle du navigateur
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        client_max_body_size 64k;

        # Passerelle injoignable : réponse JSON exploitable par le front (bandeau d'incident)
        proxy_intercept_errors off;
        error_page 502 503 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        return 503 '{"error":"SERVICE_UNAVAILABLE","service":"api","message":"La passerelle EPSI Pay est momentanément indisponible."}';
    }

    # Fichiers versionnés par Vite (hash dans le nom) : cache long
    location /assets/ {
        try_files $uri =404;
    }

    # Application monopage : toute route inconnue renvoie index.html, jamais mis en cache
    location / {
        try_files $uri /index.html;
    }
}
