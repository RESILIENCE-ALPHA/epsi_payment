# Base de données PostgreSQL 15
POSTGRES_USER=epsi_pay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=epsi_pay_db
POSTGRES_PORT=5432

# URL de connexion complète
DATABASE_URL="postgresql://epsi_pay:CHANGE_ME@localhost:5432/epsi_pay_db?schema=public"

# Ports des services
API_PORT=3000
AUTH_PORT=3001
PAYMENT_PORT=3002
FRONT_PORT=8080

# IP cliente (blocage IP, détection brute force) : la passerelle est la frontière de confiance.
# API_TRUST_PROXY = nombre de proxys devant la passerelle (1 = nginx du front en Compose,
# 2 = Ingress + nginx du front en Kubernetes). La passerelle transmet l'IP résolue seule :
# auth et payment ne font confiance qu'à elle, donc 1 dans tous les environnements.
API_TRUST_PROXY=1
AUTH_TRUST_PROXY=1

# Payment : proxy de confiance (comme auth) et jeton partagé avec le moteur de remédiation
# pour POST /payments/test-validation. Vide = route désactivée. Générer : openssl rand -hex 32
PAYMENT_TRUST_PROXY=1
PAYMENT_INTERNAL_TOKEN=

# Passerelle API : délai max (ms) avant de déclarer un service amont indisponible
UPSTREAM_TIMEOUT_MS=5000

# Passerelle API : exposer Swagger UI (/docs) et les spécifications OpenAPI (true/false).
# Vide = actif hors production, désactivé si NODE_ENV=production.
ENABLE_DOCS=

# Images Docker (registre GHCR et tag)
IMAGE_REGISTRY=ghcr.io/resilience-alpha
IMAGE_TAG=latest

# Environnement
NODE_ENV=development

# Seed de la base de données (10k ou standard)
SEED_TYPE=standard
# Quand seeder : if-empty (défaut, base vide uniquement), reset (efface TOUTES les données), never.
# En production, reset exige en plus ALLOW_DATA_RESET=true.
SEED_MODE=if-empty

# Sécurité Auth
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
