# Copier en secrets.env (ignoré par git) puis remplacer chaque valeur.
# Générer une valeur : openssl rand -hex 32  (hexadécimal : sans caractère à échapper dans DATABASE_URL)
POSTGRES_USER=epsi_pay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=epsi_pay_db
# Jeton partagé avec le moteur de remédiation (POST /payments/test-validation)
PAYMENT_INTERNAL_TOKEN=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Grafana : mot de passe du compte admin, et du compte PostgreSQL en lecture seule grafana_ro
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_DB_PASSWORD=CHANGE_ME
